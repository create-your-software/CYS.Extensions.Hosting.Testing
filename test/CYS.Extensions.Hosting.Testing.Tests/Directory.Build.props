<Project>
	<!-- Cannot apply TargetFrameworks here because it breaks Rosyln analysis in VS -->

	<!-- Applies to all .NET 8.0 projects -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net8.0' ">
		<RuntimeFrameworkVersion>8.0.32</RuntimeFrameworkVersion>
	</PropertyGroup>

	<!-- Applies to all .NET 9.0 projects -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<RuntimeFrameworkVersion>9.0.21</RuntimeFrameworkVersion>
	</PropertyGroup>

	<!-- Applies to all .NET 10.0 projects -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
	</PropertyGroup>

	<PropertyGroup>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<RepositoryType>Git</RepositoryType>
		<GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
		<ErrorReport>prompt</ErrorReport>
		<CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
		<PackageProjectUrl>https://github.com/createyour-software/createyoursoftware</PackageProjectUrl>
		<DebugType>full</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<NeutralLanguage>en-US</NeutralLanguage>
		<SupportedCultures>en-US</SupportedCultures>

		<Version>0.1.0</Version>
		<AssemblyVersion>0.1.0.0</AssemblyVersion>
		<FileVersion>0.1.0.0</FileVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>build; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>build; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

    <PropertyGroup>
        <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
        <BaseOutputPath>$(MSBuildThisFileDirectory)bin\$(MSBuildProjectName)\</BaseOutputPath>

        <DefaultItemExcludes>
            $(DefaultItemExcludes);
            $(MSBuildThisFileDirectory)obj\**;
            $(MSBuildThisFileDirectory)bin\**
        </DefaultItemExcludes>
     </PropertyGroup>

</Project>
