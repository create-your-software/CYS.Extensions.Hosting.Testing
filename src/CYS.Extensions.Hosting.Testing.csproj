<Project Sdk="Microsoft.NET.Sdk">
	
	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<NoWarn>$(NoWarn);CA1822</NoWarn>
		<PackageId>CYS.Extensions.Hosting.Testing</PackageId>
		<Description>Provides integration testing support for applications built on the .NET Generic Host.</Description>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
		<PackageProjectUrl>https://github.com/create-your-software/CYS.Extensions.Hosting.Testing</PackageProjectUrl>
		<Authors>CYS.Chris</Authors>
		<Company>CreateYour.Software</Company>
		<PackageReadmeFile>readme.md</PackageReadmeFile
		<Copyright>Copyright © Chris Trout 2026</Copyright>
		<PackageTags>dotnet;hosting;generic-host;integration-testing;testing</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<None Include="readme.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	
	<ItemGroup>
	  <AdditionalFiles Include="..\stylecop.json" Link="stylecop.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
	</ItemGroup>

</Project>
